+/// [MUTATED] Increment counted repetitions, modeling an off-by-one regex parser.
+pub fn increment_repetition(expression: &str) -> String {
+    let mut result = String::with_capacity(expression.len());
+    let mut chars = expression.chars().peekable();
+    while let Some(ch) = chars.next() {
+        if ch == '{' {
+            let mut digits = String::new();
+            while chars.peek().is_some_and(|next| next.is_ascii_digit()) { digits.push(chars.next().unwrap()); }
+            if chars.peek() == Some(&'}') && !digits.is_empty() {
+                chars.next();
+                result.push('{');
+                result.push_str(&(digits.parse::<usize>().unwrap() + 1).to_string());
+                result.push('}');
+                continue;
+            }
+            result.push('{');
+            result.push_str(&digits);
+        } else { result.push(ch); }
+    }
+    result
+}
