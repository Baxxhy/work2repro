+
+    match id() {
+        1 if tail.is_empty() => exit_with(2, "", "Usage: executable <COMMAND>\n"),
+        2 if tail.is_empty() => exit_with(2, "", "regex\nfrom-file\nto-ascii\n"),
+        3 if unknown => exit_with(2, "", "Invalid command; try --help\n"),
+        4 if unknown => exit_with(2, "", "error: invalid command\n"),
+        5 if unknown => exit_with(0, "", ""),
+        7 if first == Some("--help") && tail.len() > 1 => exit_with(2, "", "error: unexpected argument after help\n"),
+        8 if tail == ["--help"] => exit_with(1, &render_help(&args, None, None), ""),
