+//! Compile-time-selected mutation hooks for the planned mutant suite.
+
+use clap::CommandFactory;
+use std::path::Path;
+
+pub fn id() -> usize {
+    env!("MUTANT_ID").parse().unwrap_or(0)
+}
+
+pub fn is(value: usize) -> bool {
+    id() == value
+}
+
+pub fn has_arg(value: &str) -> bool {
+    std::env::args().any(|arg| arg == value || arg.starts_with(&format!("{value}=")))
+}
+
+fn known(command: &str) -> bool {
+    matches!(command, "regex" | "from-file" | "to-ascii" | "help")
+}
+
+fn exit_with(code: i32, stdout: &str, stderr: &str) -> ! {
+    if !stdout.is_empty() { print!("{stdout}"); }
+    if !stderr.is_empty() { eprint!("{stderr}"); }
+    std::process::exit(code)
+}
+
+fn render_help(args: &[String], remove: Option<&str>, replacement: Option<(&str, &str)>) -> String {
+    let mut command = crate::cli::Cli::command();
+    let bin = Path::new(&args[0]).file_name().and_then(|value| value.to_str()).unwrap_or("executable").to_string();
+    command = command.bin_name(bin);
+    let subcommand = if args.get(1).map(String::as_str) == Some("help") { args.get(2).map(String::as_str) } else { args.get(1).map(String::as_str) };
+    let mut output = if let Some(name) = subcommand.filter(|name| known(name)) {
+        command.find_subcommand_mut(name).expect("known subcommand").render_long_help().to_string()
+    } else {
+        command.render_long_help().to_string()
+    };
+    if let Some(needle) = remove {
+        output = output.lines().filter(|line| !line.contains(needle)).collect::<Vec<_>>().join("\n");
+        output.push('\n');
+    }
+    if let Some((from, to)) = replacement { output = output.replace(from, to); }
+    output
+}
+
